# Development-only performance flags for react-scripts (Create React App).
# None of these affect `npm run build` output or app behavior — they only
# change how the dev server compiles.

# Skips running ESLint as part of every webpack dev compile. Editors/IDEs
# still lint as you type, and `npm run build` still runs its own checks —
# this only removes the duplicate lint pass that was slowing down
# `npm run dev` start/rebuild time.
DISABLE_ESLINT_PLUGIN=true

# Source maps for the DEV server are unaffected by this (dev always uses
# a fast eval-based source map). This only skips writing full production
# .map files during `npm run build`, which are large and unused unless
# you're actively debugging a production bundle.
GENERATE_SOURCEMAP=false

# Backend API base URL (defaults dynamically to window.location.hostname:5000)
# REACT_APP_API_URL=https://demoteamapi.saitechnosolutions.co.in
# VITE_API_URL=https://demoteamapi.saitechnosolutions.co.in

# Local
REACT_APP_API_URL=http://localhost:5000
VITE_API_URL=http://localhost:5000


# Razorpay Test Key ID (Public key for checkout popup)
VITE_RAZORPAY_KEY=rzp_test_TBPx9EL1T1aqhC
REACT_APP_RAZORPAY_KEY=rzp_test_TBPx9EL1T1aqhC