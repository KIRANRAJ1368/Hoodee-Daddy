# ── App ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000

# ── Database (MySQL) ─────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hoodeedaddy_db
DB_USER=zmw_app
DB_PASSWORD=change_me
DB_DIALECT=mysql

# ── Auth ─────────────────────────────────────────────────────
# Generate a long random string, e.g.: openssl rand -hex 64
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=12

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins (customer frontend + admin panel)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ── Rate limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MIN=15
AUTH_RATE_LIMIT_MAX=10

# ── Uploads ──────────────────────────────────────────────────
UPLOAD_MAX_FILE_SIZE_MB=5

# ── Initial admin (used once by the admin seeder — change and
#    rotate the password after first login) ────────────────────
SEED_ADMIN_NAME=ZMW Admin
SEED_ADMIN_EMAIL=adminzmw@gmail.com
SEED_ADMIN_PASSWORD=Admin@2026

# ── Razorpay Payment Gateway ─────────────────────────────────
RAZORPAY_KEY=rzp_test_xxxxxx
RAZORPAY_KEY_SECRET=xxxxxx

# ── Shiprocket Logistics & Shipping ──────────────────────────
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_TOKEN=
SHIPROCKET_PICKUP_PINCODE=641004
SHIPROCKET_DEFAULT_WEIGHT=0.5
FREE_SHIPPING_THRESHOLD=1499
